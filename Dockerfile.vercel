# Blush & Bloom Salon - Laravel 12 on Vercel (container runtime, FrankenPHP).
# Pattern follows Vercel's guide "Deploy Laravel on Vercel with Docker".

# ---- Stage 1: production Composer dependencies (cached unless composer.lock changes) ----
FROM composer:2 AS vendor
WORKDIR /app
COPY composer.json composer.lock ./
RUN composer install --no-dev --no-scripts --no-interaction --prefer-dist --no-progress --ignore-platform-reqs

# ---- Stage 2: runtime ----
FROM dunglas/frankenphp:1-php8.4-bookworm

# pdo_mysql is required for the external MySQL database.
RUN install-php-extensions pdo_mysql pdo_pgsql intl zip opcache \
    && cp "$PHP_INI_DIR/php.ini-production" "$PHP_INI_DIR/php.ini"

COPY --from=composer:2 /usr/bin/composer /usr/bin/composer

WORKDIR /app
COPY --from=vendor /app/vendor ./vendor
COPY . .

# Runs the post-autoload hooks (package discovery) now that the whole app is present.
RUN mkdir -p storage/framework/cache/data storage/framework/sessions storage/framework/views storage/logs bootstrap/cache \
    && composer dump-autoload --no-dev --optimize --no-interaction \
    && chown -R www-data:www-data storage bootstrap/cache \
    && setcap CAP_NET_BIND_SERVICE=+ep /usr/local/bin/frankenphp \
    && chown -R www-data:www-data /data/caddy /config/caddy

# Safe defaults; override in the Vercel dashboard. Do NOT run `php artisan optimize` at build time.
ENV PORT=80 \
    APP_ENV=production \
    APP_DEBUG=false \
    LOG_CHANNEL=stderr \
    CACHE_STORE=array \
    SESSION_DRIVER=cookie \
    QUEUE_CONNECTION=sync

USER www-data
EXPOSE 80
# When RUN_MIGRATIONS=true, create/update tables and seed defaults on start-up.
# Both commands are safe to repeat (never migrate:fresh; the seeder uses firstOrCreate).
CMD ["sh", "-c", "if [ \"$RUN_MIGRATIONS\" = \"true\" ]; then php artisan migrate --force --no-interaction && php artisan db:seed --force --no-interaction; fi; exec frankenphp run --config /app/Caddyfile"]
