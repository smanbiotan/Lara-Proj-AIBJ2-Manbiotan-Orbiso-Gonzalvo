APP_NAME="Blush & Bloom Salon"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8000
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

LOG_CHANNEL=stack
LOG_LEVEL=debug

# MySQL via XAMPP (phpMyAdmin). Use your own credentials.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=blush_bloom_salon
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=file
SESSION_LIFETIME=120
CACHE_STORE=file
QUEUE_CONNECTION=sync

# Laravel itself does not send email; n8n sends appointment emails through Gmail SMTP.
MAIL_MAILER=log
MAIL_FROM_ADDRESS="no-reply@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# First administrator (created by: php artisan db:seed). Leave the password empty to generate one.
SALON_ADMIN_NAME="Blush & Bloom Salon Admin"
SALON_ADMIN_EMAIL=admin@blushbloom.salon
SALON_ADMIN_PASSWORD=

# ---- n8n integration (placeholders only – never commit real values) ----
# Workflow 1 production webhook URL, e.g. http://localhost:5678/webhook/blush-bloom-chat
N8N_CHAT_WEBHOOK_URL=
# Workflow 2 production webhook URL, e.g. http://localhost:5678/webhook/blush-bloom-appointments
N8N_APPOINTMENT_WEBHOOK_URL=
# Laravel -> n8n: sent in the X-Webhook-Secret header (generate a long random string)
N8N_WEBHOOK_SECRET=
# n8n -> Laravel: Bearer token for /api/n8n/* (at least 16 characters)
N8N_API_TOKEN=
N8N_TIMEOUT=10
N8N_CHAT_TIMEOUT=45

# ---- Continue with Google (customer sign-in) ----
# Google Cloud Console → APIs & Services → Credentials → OAuth client ID (Web application)
# Authorized redirect URI: http://127.0.0.1:8000/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://127.0.0.1:8000/auth/google/callback

# Real salon photos are loaded from Unsplash. Set to false to use the local files in public/images.
SALON_REMOTE_IMAGES=true
