# Copy these into Vercel -> Project -> Settings -> Environment Variables (Production).
# Placeholders only. NEVER commit real values.

APP_NAME="Blush & Bloom Salon"
APP_ENV=production
APP_DEBUG=false
APP_KEY=                      # php artisan key:generate --show   (keep it stable)
APP_URL=https://YOUR-PROJECT.vercel.app

LOG_CHANNEL=stderr
SESSION_DRIVER=cookie         # no sessions table needed; array/file would log everyone out on every request
SESSION_SECURE_COOKIE=true
CACHE_STORE=array
QUEUE_CONNECTION=sync

# Database: Supabase (PostgreSQL). Supabase -> Connect -> "Session pooler" (IPv4, port 5432).
DB_CONNECTION=pgsql
DB_HOST=aws-0-REGION.pooler.supabase.com
DB_PORT=5432
DB_DATABASE=postgres
DB_USERNAME=postgres.YOUR_PROJECT_REF
DB_PASSWORD=
DB_SSLMODE=require
# Creates/updates tables and default data on start-up (safe to repeat; never migrate:fresh).
RUN_MIGRATIONS=true

MAIL_MAILER=log
MAIL_FROM_ADDRESS="blushnbloom.salon@gmail.com"
MAIL_FROM_NAME="${APP_NAME}"

SALON_ADMIN_NAME="Blush & Bloom Salon Admin"
SALON_ADMIN_EMAIL=
SALON_ADMIN_PASSWORD=

# n8n (production webhooks; workflows must be ACTIVE)
N8N_CHAT_WEBHOOK_URL=https://bizflowai.app.n8n.cloud/webhook/blush-bloom-chat
N8N_APPOINTMENT_WEBHOOK_URL=https://bizflowai.app.n8n.cloud/webhook/blush-bloom-appointments
N8N_WEBHOOK_SECRET=
N8N_API_TOKEN=
N8N_TIMEOUT=10
N8N_CHAT_TIMEOUT=45

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://YOUR-PROJECT.vercel.app/auth/google/callback

SALON_REMOTE_IMAGES=true
